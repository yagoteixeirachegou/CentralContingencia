POSTGRES_DB=central_contingencia_dev
POSTGRES_USER=central_dev
POSTGRES_PASSWORD=replace_with_local_password
POSTGRES_PORT=55432


# --- Railway (valores definidos no painel/secret manager; NUNCA neste arquivo) ---
# ConnectionStrings__DefaultConnection=Host=<host>;Port=<porta>;Database=<banco>;Username=<usuario>;Password=<definir-no-painel>
# AllowedHosts=<dominio-publico>
# ReverseProxy__Enabled=true
# ReverseProxy__KnownNetworks__0=<cidr-do-proxy-da-plataforma>   # confirme o intervalo real; ver docs/RAILWAY_DEPLOYMENT.md
# DataProtection__Store=Database
# DataProtection__CertificateBase64=<pfx-em-base64>
# DataProtection__CertificatePassword=<senha-do-pfx>
# ProxyEncryption__ActiveKeyId=<id-da-chave-de-producao>
# ProxyEncryption__Keys__<id-da-chave-de-producao>=<chave-base64-de-32-bytes>
# LocalIntegrations__Enabled=false
# Freio de credenciais de serviço inválidas e recuperação de leases (opcionais; valores padrão entre parênteses)
# Security__AuthFailureLimit=10  Security__AuthFailureWindowSeconds=60  WorkQueue__RecoveryIntervalSeconds=15
# Worker (processo Windows): Worker__Api__BaseUrl=https://<dominio>  Worker__Api__Credential=<ce1....>  Worker__Api__TrustedCaFile=<apenas para CA privada>
